<?xml version="1.0"?>
<package format="2">
  <name>as_navigation</name>
  <version>0.0.0</version>
  <description>The as_navigation package</description>

  <maintainer email="bingobin.lw@gmail.com">Bingo</maintainer>
  <author email="bingobin.lw@gmail.com">Bingo</author>
  <license>TODO</license>

  <url type="website">http://www.amovauto.com/</url>
  <url type="repository">https://gitee.com/bingobinlw/volans.git</url>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>message_generation</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>quadrotor_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>yolov8_ros_msgs</build_depend>
  <build_depend>ar_track_alvar_msgs</build_depend>

  <!-- Export dependencies -->
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>tf</build_export_depend>
  <build_export_depend>mavros_msgs</build_export_depend>
  <build_export_depend>quadrotor_msgs</build_export_depend>
  <build_export_depend>yolov8_ros_msgs</build_export_depend>
  <build_export_depend>ar_track_alvar_msgs</build_export_depend>

  <!-- Runtime dependencies -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>yolov8_ros_msgs</exec_depend>
  <exec_depend>ar_track_alvar_msgs</exec_depend>

  <!-- Optional: for MoveIt integration -->
  <export>
    <moveit_core plugin="${prefix}/moveit_multi_dof_controller_manager_plugin_description.xml"/>
  </export>
</package>
