<launch>
    <node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find as_controller)/rviz/super.rviz" />

    <!-- <node pkg="rqt" type="rqt" name="rqt" /> -->

    <!-- 2026-09-10: 启动 rqt(rqt_gui), 启动即自动带上两个 Image View 插件并左右并排:
         左 = /yolov8/camera_1/detection_image/compressed
         右 = /yolov8/camera_2/detection_image/compressed
         话题在 config/super_image.perspective, 窗口大小/分屏在 scripts/super_image_rqt.py 顶部常量 -->
    <!-- 2026-09-25: 从笔记本 spadea 包同步过来, 包名已改为 as_controller -->
    <node pkg="as_controller" type="super_image_rqt.py" name="rqt" output="screen" />

    <!-- 2026-09-02 新增: rqt_image_view 分别订阅双路 yolo 检测图(compressed), 对应 super.rviz 的 Image1/Image2 -->
    <!-- 话题源: 板卡 yolov8_ros 双相机 (sky_ws), /yolov8/camera_1|2/detection_image 的压缩子话题 -->
    <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view_image1"
          args="/yolov8/camera_1/detection_image/compressed" />
    <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view_image2"
          args="/yolov8/camera_2/detection_image/compressed" /> -->
</launch>
