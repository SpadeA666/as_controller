<launch>
    <arg name="open_rviz" default="false" />
    
    <include file="$(find as_controller)/launch/move_base.launch">
    </include>

    <node pkg="as_controller" type="asnav_2d_node" name="asnav_2d_node" output="screen">  
        <param name="is_auto_land" type="bool" value="true" /> 
        <param name="target_class_name" type="string" value="A" /> 
        <param name="fly_height" type="double" value="0.4" /> 
        <param name="descend_z" type="double" value="0.4" /> 
    </node>

    <!-- <group if="$(arg open_rviz)">
			<node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find as_controller)/rviz/asnav.rviz" />
	</group> -->

    <!-- <include file="$(find usb_cam)/launch/usb_cam-test.launch">
    </include> -->

    <!-- <include file="$(find yolov8_ros)/launch/yolo_v8.launch">
    </include> -->

    <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" output="screen">
        <param name="image_topic" value="/yolov8/detection_image" />
    </node> -->

    <node pkg="location" type="trans_tf_2d" name="trans_tF_2d" />
</launch>
